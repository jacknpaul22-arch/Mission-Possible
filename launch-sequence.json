 "strings": {
  "en": {
   "pad.poll": "All stations, final poll. Launch Director, are we go for launch?",
   "pad.poll.h": "Heavy-lift on the pad, side boosters armed. All stations, final poll. Launch Director, are we go?",
   "count.go": "Go for launch.",
   "count.go.mars": "Go for launch. Next stop, Mars.",
   "count.go.moon": "Go for launch. Next stop, the Moon.",
   "lift.base": "Liftoff. Tower is clear and telemetry is flowing.",
   "lift.h": "Liftoff of the heavy-lift. You can feel that one from the control room. Tower clear.",
   "lift.s": "Liftoff. Small-lift is light and quick off the pad. Tower clear.",
   "maxq.base": "Passing max Q. Throttling down through the highest aerodynamic stress.",
   "maxq.h": "Max Q. Core is throttling down while the side boosters push through.",
   "thr.base": "Through max Q. Throttling back up.",
   "bsep.h": "Booster separation. Both side boosters are away and falling behind.",
   "meco.base": "Main engine cutoff. The first stage has done its job.",
   "meco.h": "Main engine cutoff on the core. Preparing to drop it.",
   "ssep.base": "Clean separation. Upper stage ignition, nominal thrust.",
   "ssep.h": "Core separation confirmed. Upper stage lit, thrust is nominal.",
   "fair.base": "Fairing jettison confirmed. The spacecraft is seeing sunlight for the first time.",
   "fair.s": "Fairing halves are away. Payload is exposed and healthy.",
   "seco.base": "Second engine cutoff. We are coasting to orbit.",
   "orb.base": "Orbit confirmed. Ground stations have a strong signal.",
   "orb.leo": "Orbit reached, and that is our target. Telemetry looks nominal.",
   "orb.moon": "Parking orbit achieved. Next up is the long trip to the Moon.",
   "orb.mars": "Parking orbit achieved. We commit to the Mars transfer from here.",
   "deep.moon": "Leaving Earth behind. Arrays are deployed and power looks good.",
   "deep.mars": "Deep space cruise. It is months to Mars, so everything we built has to last.",
   "deep.base": "We are in the quiet part of the mission. Keep an eye on the radiation levels.",
   "dest.base": "Approaching the target. Antennas are locked and the link is steady.",
   "dest.leo": "We are lining up with the target orbit. Antennas locked.",
   "dest.moon": "Lunar gravity is tugging at us. Lining up the capture burn.",
   "dest.mars": "Mars is filling the camera. Lining up the capture burn.",
   "burn.base": "Burn is starting. Our margin is {margin}%. Fingers crossed.",
   "ok.base": "Orbit insertion looks good. We are captured.",
   "ok.moon": "We are in lunar orbit. Welcome to the Moon.",
   "ok.mars": "Mars orbit achieved. That is the one we flew for.",
   "short.base": "We got captured, but into a lopsided orbit. Science will take a hit.",
   "failL.base": "Team, we have lost the vehicle. Pull the data and we will learn from it.",
   "failL.h": "We have lost the heavy-lift vehicle. Range safety has the debris. Pull the data and we will learn from it.",
   "failO.base": "We missed the capture and the spacecraft flew past the target. Pull the data and we will learn from it.",
   "log.meco": "Main engine cutoff.",
   "log.bsep": "Booster separation. Side boosters falling away.",
   "log.ssep": "Stage separation confirmed. Booster falling away.",
   "log.fair": "Fairing jettison.",
   "log.seco": "Second engine cutoff. Coasting.",
   "bsep.base": "Booster separation confirmed. The boosters are falling behind.",
   "tli.base": "Injection burn is go. Leaving Earth orbit.",
   "tli.moon": "Trans-lunar injection burn is go. Next stop, the Moon.",
   "tli.mars": "Trans-Mars injection burn is go. We are leaving Earth for good.",
   "usep.base": "Upper stage separation confirmed. The spacecraft is on its own now.",
   "msep.base": "Module jettison confirmed. We are lighter and ready for the burn.",
   "msep.moon": "Transfer module is away. Lining up the lunar capture burn.",
   "msep.mars": "Cruise stage is away. Lining up the Mars capture burn.",
   "failO.leo": "We missed the target orbit. The spacecraft is decaying and will reenter. Pull the data and we will learn from it.",
   "log.tli": "Injection burn. Leaving Earth orbit.",
   "log.usep": "Upper stage separation. Spacecraft is on its own.",
   "log.msep": "Module jettisoned."
  }
 },
